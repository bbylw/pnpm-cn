---
import Icon from "./Icon.astro";

const NAV = [
  { href: "/", label: "首页" },
  { href: "/docs/motivation", label: "文档" },
  { href: "/docs/feature-comparison", label: "功能对比" },
  { href: "/docs/pnpm-cli", label: "命令行" },
  { href: "/docs/installation", label: "安装" },
];
const active = Astro.url.pathname;
const isHome = (href: string) => (href === "/" ? active === "/" : active.startsWith(href));
---

<header
  class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/72"
>
  <div class="mx-auto flex h-16 max-w-[1200px] items-center gap-6 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="pnpm 首页">
      <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" class="shrink-0">
        <rect x="1.5" y="1.5" width="31" height="31" rx="6" fill="var(--color-ink)" />
        <path
          d="M6.5 6.5H11M23 6.5h4.5M6.5 27.5H11M23 27.5h4.5M6.5 6.5V11M27.5 6.5V11M6.5 23v4.5M27.5 23v4.5"
          stroke="var(--color-accent-fill)"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path>
        <text
          x="17"
          y="21.5"
          text-anchor="middle"
          font-family="var(--font-display)"
          font-weight="800"
          font-size="10.5"
          fill="var(--color-accent-fill)">pnpm</text
        >
      </svg>
      <span class="font-display text-[1.28rem] font-extrabold tracking-tight">pnpm</span>
    </a>

    <nav class="ml-2 hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            aria-current={isHome(n.href) ? "page" : undefined}
            class={`rounded-md px-3 py-2 text-[0.92rem] font-medium no-underline transition-colors ${
              isHome(n.href) ? "bg-sunken text-ink" : "text-muted hover:text-ink hover:bg-sunken/60"
            }`}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href="https://github.com/pnpm/pnpm"
        class="hidden rounded-md p-2 text-muted transition-colors hover:bg-sunken hover:text-ink sm:block"
        aria-label="GitHub 仓库"
        title="GitHub"
      >
        <Icon name="github-logo" size="1.25em" />
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md border border-line bg-raise p-2 text-muted transition-colors hover:text-ink"
        aria-label="切换明暗主题"
        title="切换明暗主题"
      >
        <span class="hidden dark:inline"><Icon name="sun" size="1.15em" /></span>
        <span class="dark:hidden"><Icon name="moon" size="1.15em" /></span>
      </button>
      <a
        href="/docs/installation"
        class="btn btn--primary px-4! py-2.5! text-[0.88rem] no-underline hidden sm:inline-flex"
      >开始使用</a>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md border border-line bg-raise p-2 text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开菜单"
      >
        <Icon name="list" size="1.25em" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-bg px-4 py-3 lg:hidden">
    <nav class="flex flex-col" aria-label="移动端导航">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            class={`rounded-md px-3 py-2.5 no-underline ${
              isHome(n.href) ? "bg-sunken font-semibold text-ink" : "text-ink hover:bg-sunken/60"
            }`}
          >
            {n.label}
          </a>
        ))
      }
      <a
        href="https://github.com/pnpm/pnpm"
        class="flex items-center gap-2 rounded-md px-3 py-2.5 text-ink no-underline hover:bg-sunken/60"
      >
        <Icon name="github-logo" size="1.1em" /> GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const html = document.documentElement;
    const next = html.dataset.theme === "dark" ? "light" : "dark";
    html.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  const menuBtn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-nav");
  const header = document.querySelector("header");
  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menuBtn?.setAttribute("aria-expanded", String(open));
    menuBtn?.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
  };
  menuBtn?.addEventListener("click", () => {
    const open = menu?.classList.contains("hidden") ?? true;
    setOpen(open);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  document.addEventListener("click", (e) => {
    const open = !(menu?.classList.contains("hidden") ?? true);
    if (open && header && e.target instanceof Node && !header.contains(e.target)) setOpen(false);
  });
</script>
