---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base title="页面不存在｜pnpm" noindex>
  <div class="mx-auto flex min-h-[62vh] max-w-[720px] flex-col items-center justify-center px-4 py-24 text-center">
    <svg width="72" height="72" viewBox="0 0 34 34" aria-hidden="true" class="opacity-90">
      <rect x="1.5" y="1.5" width="31" height="31" rx="6" fill="none" stroke="var(--color-line-strong)" stroke-width="2" stroke-dasharray="4 4" />
      <text x="17" y="22" text-anchor="middle" font-family="var(--font-display)" font-weight="800" font-size="11" fill="var(--color-muted)">?</text>
    </svg>
    <h1 class="mt-6 font-display text-[2.1rem] font-extrabold tracking-tight">这个货架是空的</h1>
    <p class="mt-3 text-[1rem] text-muted">
      要找的页面不在这里。也许链接过期了，或者内容搬了家。
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn--primary no-underline">回首页</a>
      <a href="/docs/motivation" class="btn btn--ghost no-underline">从文档开头读起</a>
      <a href="/docs/installation" class="btn btn--ghost no-underline"><Icon name="terminal" size="1.05em" /> 安装指南</a>
    </div>
    <p class="mt-10 font-mono text-[0.78rem] text-muted">404 · not found</p>
  </div>
</Base>
